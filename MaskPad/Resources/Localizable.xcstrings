        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MaskPad が、macOS の画面共有の終了後にこの Mac を再びロックするかどうかを変更しようとしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MaskPad가 macOS 화면 공유가 끝난 후 이 Mac을 다시 잠글지 여부를 변경하려고 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
