    "When sharing ends, macOS may lock the Mac again and interrupt tools under the mask. Changing this needs an administrator password.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Freigabe kann macOS den Mac wieder sperren und Werkzeuge unter der Maske unterbrechen. Zum Ändern ist ein Administratorpasswort nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When sharing ends, macOS may lock the Mac again and interrupt tools under the mask. Changing this needs an administrator password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al dejar de compartir, macOS puede volver a bloquear el Mac e interrumpir las herramientas bajo la máscara. Cambiarlo requiere la contraseña de administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la fin du partage, macOS peut reverrouiller le Mac et interrompre les outils sous le masque. La modification nécessite un mot de passe administrateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有が終わると macOS が再びロックし、マスクの下のツールが中断されることがあります。変更には管理者パスワードが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유가 끝나면 macOS가 다시 잠가 마스크 아래의 도구가 중단될 수 있습니다. 변경하려면 관리자 암호가 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享结束时 macOS 可能重新锁屏，中断遮罩下的工具。修改需要管理员密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享結束時 macOS 可能重新鎖定螢幕，中斷遮罩下的工具。修改需要管理者密碼。"
          }
        }
      }
    },
    "While waiting for automatic masking, the Mac won't sleep or lock automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zur automatischen Aktivierung der Maske wechselt der Mac nicht automatisch in den Ruhezustand und sperrt sich nicht automatisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While waiting for automatic masking, the Mac won't sleep or lock automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras espera la activación automática de la máscara, el Mac no entrará en reposo ni se bloqueará automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attendant l’activation automatique du masque, le Mac ne se met pas en veille et ne se verrouille pas automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスクの自動表示を待つ間、Macは自動でスリープやロックをしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마스크가 자동으로 표시될 때까지 Mac이 자동으로 잠자기 상태로 전환되거나 잠기지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待自动开启遮罩期间，Mac 不会自动休眠或锁定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待自動開啟遮罩期間，Mac 不會自動睡眠或鎖定。"
          }
        }
      }
    },
