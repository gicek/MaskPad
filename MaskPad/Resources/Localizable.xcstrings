          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 tentative de code incorrecte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスコードを1回間違えました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호를 1회 잘못 입력했습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码已输错 1 次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼已輸錯 1 次"
          }
        }
      }
    },
    "6 digits, used to unlock the mask.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "6 Ziffern zum Entsperren der Maske."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "6 digits, used to unlock the mask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "6 dígitos para desbloquear la máscara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "6 chiffres pour déverrouiller le masque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスクの解除に使う6桁の数字です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마스크 해제에 쓰는 6자리 숫자입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "6 位数字，用于解锁遮罩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "6 位數字，用於解鎖遮罩。"
          }
        }
      }
    },
    "A global shortcut needs at least one of Command, Option, or Control.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein globaler Kurzbefehl muss die Befehls-, Wahl- oder Control-Taste enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A global shortcut needs at least one of Command, Option, or Control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un atajo global necesita al menos Comando, Opción o Control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un raccourci global doit comporter au moins Commande, Option ou Contrôle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グローバルショートカットには Command、Option、Control のいずれかが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전역 단축키에는 Command, Option, Control 중 하나 이상이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全局快捷键至少需要 Command、Option 或 Control 中的一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全域快速鍵至少需要 Command、Option 或 Control 其中之一。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca de"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À propos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリについて"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정보"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於"
          }
        }
      }
    },
    "Accessibility permission is needed to block the keyboard and mouse.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Blockieren von Tastatur und Maus ist die Bedienungshilfen-Berechtigung nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission is needed to block the keyboard and mouse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita permiso de Accesibilidad para bloquear el teclado y el ratón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation Accessibilité est nécessaire pour bloquer le clavier et la souris."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードとマウスをブロックするにはアクセシビリティの許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드와 마우스를 차단하려면 손쉬운 사용 권한이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能权限才能拦截键盘和鼠标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要輔助使用權限才能攔截鍵盤和滑鼠。"
          }
        }
      }
    },
    "Adds the maskpad command to /usr/local/bin. May ask for an administrator password.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt den Befehl maskpad zu /usr/local/bin hinzu. Eventuell ist ein Administratorpasswort nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds the maskpad command to /usr/local/bin. May ask for an administrator password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el comando maskpad a /usr/local/bin. Puede pedir una contraseña de administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute la commande maskpad à /usr/local/bin. Un mot de passe administrateur peut être demandé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "maskpad コマンドを /usr/local/bin に追加します。管理者パスワードが必要な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "maskpad 명령을 /usr/local/bin에 추가합니다. 관리자 암호가 필요할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 maskpad 命令添加到 /usr/local/bin。可能需要输入管理员密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 maskpad 指令加入 /usr/local/bin。可能需要輸入管理者密碼。"
          }
        }
      }
    },
