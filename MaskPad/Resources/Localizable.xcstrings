    "After 20 seconds without activity, hides the keypad and dims the screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet nach 20 Sekunden ohne Aktivität das Ziffernfeld aus und dunkelt den Bildschirm ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras 20 segundos sin actividad, oculta el teclado numérico y atenúa la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après 20 secondes sans activité, masque le pavé et assombrit l’écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作がないまま20秒経つと、キーパッドを隠して画面を暗くします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "20초 동안 활동이 없으면 키패드를 숨기고 화면을 어둡게 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遮罩期间 20 秒无操作，隐藏数字键盘并调暗屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遮罩期間 20 秒無操作，隱藏數字鍵盤並調暗螢幕。"
          }
        }
      }
    },
