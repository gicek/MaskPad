root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,sh,json,xcstrings,md,svg}]
indent_size = 2

[Makefile]
indent_style = tab

# The translation table indents values by one space.
[Scripts/translations.py]
indent_size = 1

[*.md]
trim_trailing_whitespace = false
