    "MaskPad wants to change whether this Mac locks again after macOS Screen Sharing ends.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MaskPad möchte ändern, ob dieser Mac nach Ende der macOS-Bildschirmfreigabe wieder gesperrt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
