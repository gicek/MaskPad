    "Unlock with Mac Password": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Mac-Passwort entsperren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquear con la contraseña del Mac"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouiller avec le mot de passe du Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac のパスワードで解除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 암호로 잠금 해제"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用系统密码解锁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用系統密碼解鎖"
          }
        }
      }
    },
    "Until the mask turns on, the Mac won't lock or sleep on its own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis die Maske aktiviert wird, sperrt sich der Mac nicht und wechselt nicht in den Ruhezustand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que se active la máscara, el Mac no se bloqueará ni entrará en reposo por sí solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que le masque n’est pas activé, le Mac ne se verrouille pas et ne se met pas en veille de lui-même."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスクがオンになるまで、Mac は自動でロックやスリープをしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마스크가 켜질 때까지 Mac은 자동으로 잠기거나 잠자기 상태로 전환되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启遮罩前，Mac 不会自动锁屏或休眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟遮罩前，Mac 不會自動鎖定或睡眠。"
          }
        }
      }
    },
