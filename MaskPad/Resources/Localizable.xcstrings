          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此快速鍵已被其他應用程式佔用，請換一個。"
          }
        }
      }
    },
    "Too many attempts. Try again in %llds": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Versuche es in %lld s erneut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos. Vuelve a intentarlo en %lld s"
          }
        },
        "fr": {
