  "strings": {
    "%lld wrong passcode attempts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld falsche Codeversuche"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld wrong passcode attempts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld intentos de código incorrectos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tentatives de code incorrectes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスコードを%lld回間違えました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호를 %lld회 잘못 입력했습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码已输错 %lld 次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼已輸錯 %lld 次"
          }
        }
      }
    },
    "1 wrong passcode attempt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 falscher Codeversuch"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 wrong passcode attempt"
          }
        },
        "es": {
          "stringUnit": {
